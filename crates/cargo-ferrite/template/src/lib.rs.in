use ferrite_api::prelude::*;

struct %type% {
    ticks: u64,
}

impl Mod for %type% {
    fn init(hooks: &mut Hooks<Self>) -> Result<Self, Error> {
        hooks
            .command("hello", Self::hello)
            .on_tick(|state, _| state.ticks += 1);
        log::info("%id%: loaded");
        Ok(Self { ticks: 0 })
    }
}

impl %type% {
    fn hello(&mut self, args: Args) -> CommandResult {
        let who = args.word(0).unwrap_or("world");
        chat::show(format!("Hello, {who}!"));
        reply(format!("{} ticks since load", self.ticks))
    }
}

export_mod!(%type%);

#[cfg(test)]
mod tests {
    use ferrite_api::testing::TestGame;

    use super::*;

    #[test]
    fn hello_greets_and_counts_ticks() {
        let mut game = TestGame::<%type%>::start();
        game.ticks(20);
        assert_eq!(
            game.command("hello Steve"),
            Ok(Some("20 ticks since load".into()))
        );
        assert_eq!(game.take_chat(), ["Hello, Steve!"]);
    }
}
